---
import "../styles/comparison.css";
import "../styles/comparison-faq.css";
import type { Language } from "../lib/content";
interface Props { lang: Language; }
const { lang } = Astro.props;

const copy = {
  es: {
    eyebrow: "Aclaración de nombres",
    clarificationTitle: "Aclaración: ¿cuál es esta \"Gran Salina\"?",
    clarificationBody: "greatsaltflat.com trata sobre Salinas Grandes en Jujuy, Argentina: una salar de alta Puna sobre la Ruta Nacional 52. No es una guía para las Bonneville Salt Flats ni el Great Salt Lake Desert de Utah, Estados Unidos, ni para el Salar de Uyuni de Bolivia.",
    relatedPlaces: "Lugares relacionados",
    bonnevilleLink: "Bonneville Salt Flats, Utah",
    uyuniSpan: "Salar de Uyuni, Bolivia",
    sectionTag: "Contexto global",
    comparisonTitle: "Salinas Grandes frente a Salar de Uyuni: y dónde entra Utah.",
    comparisonIntro: "Estos paisajes comparten sal, horizontes luminosos y gran impacto visual, pero son lugares distintos con geografía, reglas de acceso y contexto visitante diferentes. Esta comparación mantiene el foco en la Great Salt Flat Argentina que encontrás en este sitio.",
    tableLabel: "Tabla de comparación de salares",
    theadCompare: "Comparar",
    theadArg: "Gran Salina de Argentina",
    theadArgSub: "Salinas Grandes, Jujuy",
    theadUsa: "Bonneville Salt Flats",
    theadUsaSub: "Utah, EE. UU.",
    theadBol: "Salar de Uyuni",
    theadBolSub: "Bolivia",
    rowLocation: "Ubicación y región",
    locationArg: "Puna jujeña, norte de Argentina, en los Andes australes.",
    locationUsa: "Cuenca del Gran Lago Salado, condado de Tooele, Utah.",
    locationBol: "Suroeste de Bolivia, sobre el Altiplano.",
    rowElevation: "Altitud",
    elevationArg: "c. 3.450 m s.n.m.",
    elevationUsa: "c. 1.300 m s.n.m.",
    elevationBol: "3.656 m s.n.m.",
    rowHighlights: "Características destacadas",
    highlightsArg: "Ojos de agua de tono azul profundo, cristales salinos hexagonales y piletas de cristalización dentro de un paisaje productivo de alta Puna.",
    highlightsUsa: "Corteza salina blanca y compacta, recreación administrada por el BLM y patrimonio histórico de carreras de velocidad.",
    highlightsBol: "Un salar altiplánico extenso y azotado por el viento, con una identidad boliviana bien diferenciada.",
    rowAccess: "Accesibilidad",
    accessArg: "RN 52 desde Purmamarca o Salta por la Cuesta de Lipán; excursión de día con confirmación de clima, ruta y guía el mismo día.",
    accessUsa: "I-80, salida 4 cerca de Wendover; acceso público sujeto a cierres estacionales y por eventos.",
    accessBol: "Destino independiente del suroeste boliviano; conviene verificar rutas locales y condiciones de tours por separado.",
    notes1Eyebrow: "Foco de esta guía",
    notes1Title: "Great Salt Flat Argentina significa Salinas Grandes, Jujuy.",
    notes1Body: "Desde Purmamarca, la RN 52 asciende por la Cuesta de Lipán antes de llegar al salar. El trayecto forma parte de la experiencia y requiere preparación para la altura.",
    notes2Eyebrow: "Una distinción útil",
    notes2Title: "Utah Great Salt Lake Desert frente a Argentina Salt Flat.",
    notes2Body: "Bonneville es un área recreativa gestionada por el BLM en el oeste de los Estados Unidos. Salinas Grandes es un paisaje de Puna andina donde el acceso guiado local, la extracción salinera y las condiciones de montaña dan forma a una visita de otra índole.",
    faqEyebrow: "FAQ de planificación",
    faqTitle: "Preguntas de viaje y clima, respondidas.",
    faqIntro: "Usá estas distinciones para planificar con responsabilidad. Las condiciones, accesos viales y normativas locales pueden cambiar sin aviso previo.",
    faq: [
      ["¿Puedo visitar Salinas Grandes en excursión de día desde Purmamarca?", "Salinas Grandes está a 66 km de Purmamarca por la RN 52, sobre la Cuesta de Lipán. No hay ómnibus público directo según Jujuy Turismo, así que organizá vehículo, traslado o excursión con antelación. Tratá el recorrido como un viaje de altura y revisá las condiciones el mismo día."],
      ["¿Cómo afecta el clima al acceso a estos salares?", "En Salinas Grandes, el clima puede impedir el ingreso al interior. En Bonneville, el BLM limita el uso vehicular cuando la sal está húmeda o hay agua acumulada, y puede restringir el acceso durante eventos autorizados. Las condiciones del Salar de Uyuni conviene consultarlas por separado en forma local; ninguna tabla o pronóstico reemplaza un aviso de acceso del mismo día."],
      ["¿Se puede circular en vehículo por todos los salares?", "No: las normas son propias de cada lugar. En Salinas Grandes, los visitantes siguen a guías locales por huellas establecidas. Bonneville permite conducir solo cuando está abierta y las condiciones lo admiten. Para el Salar de Uyuni, seguí las indicaciones de las autoridades locales y el operador que elijas."],
      ["¿Qué destinos requieren preparación para la altura?", "Salinas Grandes ronda los 3.450 m y el Salar de Uyuni unos 3.656 m, mientras que Bonneville está mucho más baja, a unos 1.300 m. Los itinerarios por la Puna y el Altiplano exigen ritmo conservador, ropa de abrigo, agua y protección solar. Sumale tiempo extra a la ruta en lugar de tratar la altura como una parada rápida de camino."],
      ["¿Esta página ofrece pronóstico en vivo para Utah o Uyuni?", "No. El panel meteorológico de este sitio usa coordenadas fijas solo para Salinas Grandes, Jujuy. Para Utah y Bolivia, recurrí a las autoridades locales, información al visitante y orientación de operadores vigentes antes de viajar."],
    ] as const,
  },
  en: {
    eyebrow: "Place name clarification",
    clarificationTitle: "Clarification: Which \"Great Salt Flat\" is This?",
    clarificationBody: "greatsaltflat.com is about Salinas Grandes in Jujuy, Argentina: a high-Puna salt flat on National Route 52. It is not a visitor guide to Utah's Bonneville Salt Flats or Great Salt Lake Desert in the United States, nor to Bolivia's Salar de Uyuni.",
    relatedPlaces: "Related places",
    bonnevilleLink: "Bonneville Salt Flats, Utah",
    uyuniSpan: "Salar de Uyuni, Bolivia",
    sectionTag: "Global context",
    comparisonTitle: "Salinas Grandes vs Salar de Uyuni: and where Utah fits.",
    comparisonIntro: "These landscapes share salt, bright horizons and high visual impact, but they are distinct places with different geography, access rules and visitor context. This comparison keeps the focus on the <strong>Great Salt Flat Argentina</strong> visitors find on this site.",
    tableLabel: "Salt flat comparison table",
    theadCompare: "Compare",
    theadArg: "Argentina's Great Salt Flat",
    theadArgSub: "Salinas Grandes, Jujuy",
    theadUsa: "Bonneville Salt Flats",
    theadUsaSub: "Utah, USA",
    theadBol: "Salar de Uyuni",
    theadBolSub: "Bolivia",
    rowLocation: "Location &amp; region",
    locationArg: "Jujuy Puna, northern Argentina, in the southern Andes.",
    locationUsa: "Great Salt Lake Basin, Tooele County, Utah.",
    locationBol: "Southwestern Bolivia, on the Altiplano.",
    rowElevation: "Elevation",
    elevationArg: "c. 3,450 m / 11,319 ft",
    elevationUsa: "c. 1,300 m / 4,265 ft",
    elevationBol: "3,656 m / 11,995 ft",
    rowHighlights: "Key highlights",
    highlightsArg: "Signature deep-blue natural water eyes (Ojos de Agua), hexagonal salt-crystal textures and crystallisation pools within a working high-Puna landscape.",
    highlightsUsa: "Hard white salt crust, BLM-managed recreation and a land-speed-racing heritage.",
    highlightsBol: "An expansive, windswept Altiplano salt flat with a distinct Bolivian character.",
    rowAccess: "Accessibility",
    accessArg: "RN 52 from Purmamarca or Salta via Cuesta de Lipán; a seamless day trip with same-day confirmation of weather, road status and guided entry.",
    accessUsa: "I-80, Exit 4 near Wendover; public access is subject to seasonal and event closures.",
    accessBol: "A separate southwest-Bolivia destination; local routes and tour conditions should be checked independently.",
    notes1Eyebrow: "Focus of this guide",
    notes1Title: "Great Salt Flat Argentina means Salinas Grandes, Jujuy.",
    notes1Body: "From Purmamarca, RN 52 climbs through Cuesta de Lipán before reaching the salt flat. The road journey is part of the experience and requires high-altitude preparation.",
    notes2Eyebrow: "A useful distinction",
    notes2Title: "Utah Great Salt Lake Desert vs Argentina Salt Flat.",
    notes2Body: "Bonneville is a BLM-managed recreation area in the western United States. Salinas Grandes is an Andean Puna landscape where local guided access, salt production and mountain conditions shape a different kind of visit.",
    faqEyebrow: "Trip planning FAQ",
    faqTitle: "Travel and climate questions, answered.",
    faqIntro: "Use these distinctions to plan responsibly. Conditions, road access and local rules can change without notice.",
    faq: [
      ["Can I visit Salinas Grandes as a day trip from Purmamarca or Salta?", "Salinas Grandes is 66 km from Purmamarca on RN 52, over Cuesta de Lipán. There is no direct public bus according to Jujuy Turismo, so organise a vehicle, transfer or excursion in advance. Treat the journey as a high-altitude road trip and check conditions again on the day."],
      ["How does weather affect access to these salt flats?", "At Salinas Grandes, weather can prevent entry to the interior. At Bonneville, the BLM limits vehicle use when the salt is wet or standing water is present and may restrict access during permitted events. Conditions at Salar de Uyuni should be checked locally and separately; no table or forecast replaces a same-day access notice."],
      ["Can I drive on every salt flat?", "No—rules are specific to each place. In Salinas Grandes, visitors follow local guides on established tracks. Bonneville allows driving only when it is open and conditions permit. For Salar de Uyuni, follow the instructions of local authorities and the operator you choose."],
      ["Which destinations need high-altitude preparation?", "Salinas Grandes sits around 3,450 m and Salar de Uyuni at about 3,656 m, while Bonneville is much lower at roughly 1,300 m. High-Puna and Altiplano itineraries call for a conservative pace, warm layers, water and sun protection. Build extra time into the route rather than treating altitude as a quick roadside stop."],
      ["Does this page provide a live forecast for Utah or Uyuni?", "No. The weather panel on this site uses fixed coordinates for Salinas Grandes, Jujuy only. For Utah and Bolivia, use the relevant local authorities, visitor information and current operator guidance before travelling."],
    ] as const,
  },
} as const;

const t = copy[lang];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: t.faq.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) };
---

<aside class="clarification" aria-labelledby="clarification-title">
  <div class="clarification-mark" aria-hidden="true"><span>?</span><i></i></div>
  <div>
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="clarification-title" set:html={t.clarificationTitle}></h2>
    <p set:html={t.clarificationBody}></p>
  </div>
  <div class="clarification-links" aria-label={t.relatedPlaces}>
    <a href="https://www.blm.gov/visit/bonneville-salt-flats" target="_blank" rel="noreferrer">{t.bonnevilleLink} <span aria-hidden="true">↗</span></a>
    <span>{t.uyuniSpan}</span>
  </div>
</aside>

<section id="compare" class="comparison-section" aria-labelledby="comparison-title">
  <div class="comparison-intro">
    <div class="section-tag"><span>02A</span>{t.sectionTag}</div>
    <h2 id="comparison-title" set:html={t.comparisonTitle}></h2>
    <p set:html={t.comparisonIntro}></p>
  </div>
  <div class="comparison-table-wrap" role="region" aria-label={t.tableLabel} tabindex="0">
    <table class="comparison-table">
      <thead>
        <tr>
          <th scope="col">{t.theadCompare}</th>
          <th scope="col" class="focus-column">
            {t.theadArg}<br/><span>{t.theadArgSub}</span>
          </th>
          <th scope="col">
            {t.theadUsa}<br/><span>{t.theadUsaSub}</span>
          </th>
          <th scope="col">
            {t.theadBol}<br/><span>{t.theadBolSub}</span>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row" set:html={t.rowLocation}></th>
          <td data-label={lang === "en" ? "Argentina" : "Argentina"} class="focus-column">{t.locationArg}</td>
          <td data-label={lang === "en" ? "Utah" : "Utah"}>{t.locationUsa}</td>
          <td data-label={lang === "en" ? "Bolivia" : "Bolivia"}>{t.locationBol}</td>
        </tr>
        <tr>
          <th scope="row">{t.rowElevation}</th>
          <td data-label={lang === "en" ? "Argentina" : "Argentina"} class="focus-column">{t.elevationArg}</td>
          <td data-label={lang === "en" ? "Utah" : "Utah"}>{t.elevationUsa}</td>
          <td data-label={lang === "en" ? "Bolivia" : "Bolivia"}>{t.elevationBol}</td>
        </tr>
        <tr>
          <th scope="row">{t.rowHighlights}</th>
          <td data-label={lang === "en" ? "Argentina" : "Argentina"} class="focus-column">{t.highlightsArg}</td>
          <td data-label={lang === "en" ? "Utah" : "Utah"}>{t.highlightsUsa}</td>
          <td data-label={lang === "en" ? "Bolivia" : "Bolivia"}>{t.highlightsBol}</td>
        </tr>
        <tr>
          <th scope="row">{t.rowAccess}</th>
          <td data-label={lang === "en" ? "Argentina" : "Argentina"} class="focus-column">{t.accessArg}</td>
          <td data-label={lang === "en" ? "Utah" : "Utah"}>{t.accessUsa}</td>
          <td data-label={lang === "en" ? "Bolivia" : "Bolivia"}>{t.accessBol}</td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="comparison-notes">
    <article>
      <p class="eyebrow">{t.notes1Eyebrow}</p>
      <h3 set:html={t.notes1Title}></h3>
      <p>{t.notes1Body}</p>
    </article>
    <article>
      <p class="eyebrow">{t.notes2Eyebrow}</p>
      <h3 set:html={t.notes2Title}></h3>
      <p>{t.notes2Body}</p>
    </article>
  </div>
  <section class="comparison-faq" aria-labelledby="comparison-faq-title">
    <div class="comparison-faq-heading">
      <p class="eyebrow">{t.faqEyebrow}</p>
      <h2 id="comparison-faq-title">{t.faqTitle}</h2>
      <p>{t.faqIntro}</p>
    </div>
    <div class="comparison-faq-list">
      {t.faq.map(([question, answer]) => (
        <details>
          <summary>{question}<span aria-hidden="true">+</span></summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
