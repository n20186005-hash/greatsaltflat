---
import BaseLayout from "../layouts/BaseLayout.astro";
import WeatherSection from "./WeatherSection.astro";
import DisambiguationComparison from "./DisambiguationComparison.astro";
import VisitorInfo from "./VisitorInfo.astro";
import {attractionSchema,copy,imageUrls,placeFacts,type Language} from "../lib/content";
const {lang}=Astro.props as {lang:Language};const t=copy[lang],es=lang==='es',home=es?'/':'/en/';
const official='https://www.argentina.travel/novedades/cinco-destinos-turisticos-argentinos-para-visitar-en-junio';
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:t.faq.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
const reviews=new Intl.NumberFormat(es?'es-AR':'en-US').format(Number(placeFacts.reviewCount));
---
<BaseLayout lang={lang} title={t.title} description={t.description} canonicalPath={home}><main id="main-content">
<section class="hero" aria-labelledby="hero-title"><img class="hero-photo" src={imageUrls.hero} alt={es?'Salinas Grandes en una fotografía de archivo de 2008':'Salinas Grandes in an archive photograph from 2008'} width="1600" height="1200" fetchpriority="high"/><div class="hero-overlay"></div><div class="hero-content"><p class="eyebrow light">{t.eyebrow}</p><h1 id="hero-title">{t.heroTitle}</h1><p class="hero-intro">{t.heroIntro}</p><div class="hero-actions"><a class="button button-primary" href="#planifica">{t.primaryCta}</a><a class="button button-ghost" href="https://maps.app.goo.gl/VENAP9GkKEWXUcsY6" target="_blank" rel="noopener noreferrer">{t.secondaryCta} ↗</a></div></div><div class="hero-facts">{t.facts.map(([value,label])=><div><b>{value}</b><span>{label}</span></div>)}</div></section>
<p class="photo-credit-bar">Salinas Grandes · 2008 · Gonzalo Rivero · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a> · <a href="#photo-credits">{es?'Fuente y cambios':'Source and changes'}</a></p>
<section class="alert-strip"><span class="map-pin" aria-hidden="true">✦</span><div><strong>{t.quickTitle}</strong><p>{t.quickText}</p></div></section>
<DisambiguationComparison lang={lang}/>
<section id="planifica" class="section access-grid"><div class="section-tag"><span>01</span>{es?'Ingreso':'Entry'}</div><div><h2>{t.accessTitle}</h2><p class="lead">{t.accessBody}</p><p><a href={official} target="_blank" rel="noopener noreferrer">Visit Argentina · {es?'11 de junio de 2026':'11 June 2026'} ↗</a></p></div><div class="fee-panel"><span>{t.priceLabel}</span><strong>{t.priceValue}</strong><p>{t.priceNote}</p><hr/><h3>{t.bestTitle}</h3><p>{t.bestText}</p><p><a href="https://maps.app.goo.gl/VENAP9GkKEWXUcsY6" target="_blank" rel="noopener noreferrer">{es?'Ver ficha actual de Maps':'Open the current Maps listing'} ↗</a></p></div></section>
<section id="salar" class="section intro-grid"><div class="section-tag"><span>02</span>{t.learnKicker}</div><div><h2>{t.learnTitle}</h2><p class="lead">{t.learnBody}</p></div><aside class="coordinate-card"><span>{es?'Punto de referencia, no todo el salar':'Reference point, rather than the whole flat'}</span><b>23.6085346° S<br/>65.8645729° W</b><p>{placeFacts.address}</p><p>{es?'Confirmá en el parador el recorrido y el acceso habilitado.':'Confirm the authorised route and entry at the visitor stop.'}</p></aside></section>
<section class="image-break image-route"><img src={imageUrls.route} alt={es?'RN 52 por Cuesta de Lipán, fotografía de archivo de 2008':'RN 52 at Cuesta de Lipán, archive photograph from 2008'} width="1600" height="1200" loading="lazy"/><div><p class="eyebrow light">{t.routeKicker}</p><h2>{t.routeTitle}</h2><p>{t.routeBody}</p></div></section>
<p class="photo-credit-bar">Cuesta de Lipán · 2008 · Gonzalo Rivero · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a> · <a href="#photo-credits">{es?'Fuente y cambios':'Source and changes'}</a></p>
<section class="section planning-section"><div class="section-heading"><div class="section-tag"><span>03</span>{t.planKicker}</div><h2>{t.planTitle}</h2><p>{t.planIntro}</p></div><div class="planning-list">{t.planning.map(([title,body],i)=><article><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section id="llegar" class="section transport-section"><div class="transport-copy"><div class="section-tag"><span>04</span>{t.gettingKicker}</div><h2>{t.gettingTitle}</h2><img src={imageUrls.documentedPools} alt={es?'Fotografía de archivo de las piletas salineras, 2007':'Archive photograph of salt-processing pools, 2007'} width="1196" height="1600" loading="lazy"/><p class="photo-credit-bar">Guerretto · 2007 · <a href="#photo-credits">{es?'Fuente y licencia CC BY 2.0':'Source and CC BY 2.0 licence'}</a></p></div><div class="transport-list">{t.transport.map(([title,body])=><article><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section class="map-section" id="mapa"><div><p class="eyebrow">{t.mapKicker}</p><h2>{t.mapTitle}</h2><p>{placeFacts.address}</p><p>{t.mapText}</p><ul class="place-meta"><li><span>{es?'Referencia de terceros':'Third-party reference'}</span><b>★ {placeFacts.ratingValue} · {reviews} <small>Google Maps · 23/10/2026</small></b></li></ul><p>{es?'La cifra y el horario son una consulta fechada de esta ficha; pueden cambiar. No son una evaluación propia ni un permiso para entrar.':'The rating and hours are a dated listing snapshot and may change. They are not an own assessment or permission to enter.'}</p><a href="https://maps.app.goo.gl/VENAP9GkKEWXUcsY6" target="_blank" rel="noopener noreferrer">{es?'Abrir mapa y ruta':'Open map and directions'} ↗</a></div><iframe title={es?'Punto de visita de Salinas Grandes':'Salinas Grandes visitor reference point'} src="https://www.google.com/maps?q=-23.6085346,-65.8645729&z=16&output=embed" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></section>
<WeatherSection lang={lang}/>
<VisitorInfo lang={lang}/>
<section id="preguntas" class="section faq-section"><div><div class="section-tag"><span>05</span>{t.faqKicker}</div><h2>{t.faqTitle}</h2></div><div class="faq-list">{t.faq.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
<section class="source-section" id="fuentes"><div><p class="eyebrow">{es?'Fuentes · 23/10/2026':'Sources · 23 October 2026'}</p><h2>{t.sourceTitle}</h2><p>{es?'Las fichas nacionales describen distintas superficies y altitudes medias para el conjunto del salar. No usamos esas cifras como una medición de este punto de visita. Confirmá cargos, guía, ruta y último ingreso para tu fecha.':'National profiles give differing area and average-elevation figures for the wider salt flat. They are not used as measurements of this visitor point. Confirm fees, guiding, the road and last entry for your date.'}</p></div><div class="source-links"><a href={official}>Visit Argentina · {es?'guía e ingreso, junio 2026':'guiding and access, June 2026'} ↗</a><a href="https://www.argentina.travel/actividades/salinas-grandes-jujuy">Visit Argentina · Jujuy ↗</a><a href="https://www.argentina.travel/actividades/salinas-grandes">Visit Argentina · Salinas Grandes ↗</a><a href="https://www.turismo.jujuy.gob.ar/">{es?'Turismo de Jujuy':'Jujuy Tourism'} ↗</a></div></section>
</main><script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script><script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script></BaseLayout>
