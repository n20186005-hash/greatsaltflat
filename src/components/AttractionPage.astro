---
// Mapa de Sal style reminder: asymmetric route narrative with mineral whitespace, exact geographic references and restrained motion.
import BaseLayout from "../layouts/BaseLayout.astro";
import WeatherWidget from "./WeatherWidget.astro";
import DisambiguationComparison from "./DisambiguationComparison.astro";
import { attractionSchema, copy, imageUrls, type Language } from "../lib/content";
interface Props { lang: Language; }
const { lang } = Astro.props; const t = copy[lang]; const home = lang === "en" ? "/en/" : "/";
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: t.faq.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) };
const mapSrc="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6502.520771173846!2d-65.86714782285839!3d-23.608534578767536!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9403558cccbe9041%3A0x9164c69c7a51236b!2sGreat%20Salt%20Flat!5e1!3m2!1ses!2sar!4v1787796046893!5m2!1ses!2sar";
const seo = lang === "es" ? { title: "Salinas Grandes, Jujuy: guía para planificar una visita", description: "Tiempo local, Ruta Nacional 52, Cuesta de Lipán y recomendaciones prácticas para visitar Salinas Grandes con preparación y respeto.", keywords: "Salinas Grandes, Jujuy, Ruta Nacional 52, Cuesta de Lipán, Puna, clima, pronóstico, Purmamarca" } : { title: "Great Salt Flat Argentina: Salinas Grandes weather, RN 52 and travel guide", description: "Plan a Salinas Grandes, Jujuy visit with local weather, RN 52 context and a clear Great Salt Flat Argentina comparison with Utah and Salar de Uyuni.", keywords: "Great Salt Flat Argentina, Salinas Grandes vs Salar de Uyuni, Utah Great Salt Lake Desert vs Argentina Salt Flat, Salinas Grandes weather, RN 52, Cuesta de Lipán, Purmamarca, Argentina salt flats, Puna travel guide" };
const verification = lang === "es" ? { kicker: "Antes de salir", title: "Verificá la ruta y el ingreso el mismo día.", intro: "En temporada alta o con lluvias, usá esta secuencia como chequeo final. Los valores y accesos de esta guía son referencias, no un aviso operativo.", steps: [["Consultá el contexto oficial", "Revisá la página de Salinas Grandes de Jujuy Turismo para confirmar el horario de guías, restricciones climáticas comunicadas y las condiciones generales de visita.", "Abrir Jujuy Turismo"], ["Confirmá condiciones de circulación", "Antes de ascender por la RN 52, contrastá avisos vigentes de Turismo de Jujuy y autoridades viales. Si las condiciones cambian, priorizá su indicación sobre cualquier plan previo.", "Abrir Turismo de Jujuy"], ["Validá en el parador", "Al llegar, consultá directamente con los guías locales el importe por vehículo, los medios de pago, el último horario de ingreso y si el recorrido interior está habilitado.", "Ver referencia de ingreso"]] } : { kicker: "Before departure", title: "Check the road and entry on the same day.", intro: "In high season or rainy conditions, use this sequence as a final trip check. Amounts and access details in this guide are references, not an operational notice.", steps: [["Review official context", "Check Jujuy Turismo’s Salinas Grandes page for guide hours, weather-related restrictions and current general visitor guidance.", "Open Jujuy Turismo"], ["Confirm road conditions", "Before climbing RN 52, compare current notices from Jujuy Tourism and road authorities. If conditions change, follow their guidance over any earlier plan.", "Open Jujuy Tourism"], ["Validate at the parador", "On arrival, ask local guides directly about the per-vehicle fee, payment methods, final entry time and whether the interior route is open.", "View admission reference"]] };
---
<BaseLayout lang={lang} title={t.title} description={t.description} canonicalPath={home} socialTitle={seo.title} socialDescription={seo.description} keywords={seo.keywords}><main>
  <section class="hero" aria-labelledby="hero-title"><img class="hero-photo" src={imageUrls.hero} alt={lang==="es"?"Planicie salina de Salinas Grandes bajo el cielo de la Puna":"Salinas Grandes salt flat beneath the Puna sky"}/><div class="hero-overlay"></div><div class="hero-content"><p class="eyebrow light">{t.eyebrow}</p><h1 id="hero-title">{t.heroTitle}</h1><p class="hero-intro">{t.heroIntro}</p><div class="hero-actions"><a class="button button-primary" href="#planifica">{t.primaryCta}</a><a class="button button-ghost" href="https://maps.app.goo.gl/VENAP9GkKEWXUcsY6" target="_blank" rel="noreferrer">{t.secondaryCta}<span aria-hidden="true">↗</span></a></div></div><div class="hero-facts">{t.facts.map(([value,label])=><div><b>{value}</b><span>{label}</span></div>)}</div></section>
  <section class="alert-strip"><span class="map-pin" aria-hidden="true">✦</span><div><strong>{t.quickTitle}</strong><p>{t.quickText}</p></div></section>
  <WeatherWidget lang={lang} />
  {lang === "en" && <DisambiguationComparison />}
  <section id="salar" class="section intro-grid"><div class="section-tag"><span>01</span>{t.learnKicker}</div><div><h2>{t.learnTitle}</h2><p class="lead">{t.learnBody}</p></div><aside class="coordinate-card"><span>{lang==="es"?"Punto de referencia":"Reference point"}</span><b>23.608535° S<br/>65.867148° O</b><p>{t.locationBody}</p><a href="https://www.argentina.travel/actividades/salinas-grandes-jujuy" target="_blank" rel="noreferrer">Visit Argentina <span aria-hidden="true">↗</span></a></aside></section>
  <section class="image-break image-route"><img src={imageUrls.route} alt={lang==="es"?"Ruta de montaña hacia la Cuesta de Lipán":"Mountain road through Cuesta de Lipán"}/><div><p class="eyebrow light">{t.routeKicker}</p><h2>{t.routeTitle}</h2><p>{t.routeBody}</p></div></section>
  <section class="section access-grid"><div class="section-tag"><span>02</span>{lang==="es"?"Visita":"Visit"}</div><div><h2>{t.accessTitle}</h2><p class="lead">{t.accessBody}</p></div><div class="fee-panel"><span>{t.priceLabel}</span><strong>{t.priceValue}</strong><p>{t.priceNote}</p><hr/><h3>{t.bestTitle}</h3><p>{t.bestText}</p></div></section>
  <section id="planifica" class="section planning-section"><div class="section-heading"><div class="section-tag"><span>03</span>{t.planKicker}</div><h2>{t.planTitle}</h2><p>{t.planIntro}</p></div><div class="planning-list">{t.planning.map(([title,body],index)=><article><span>0{index+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
  <section class="section verification-section"><div><div class="section-tag"><span>04</span>{verification.kicker}</div><h2>{verification.title}</h2><p class="lead">{verification.intro}</p></div><ol class="verification-steps">{verification.steps.map(([title, body, action], index) => <li><span>0{index + 1}</span><div><h3>{title}</h3><p>{body}</p><a href={index === 1 ? "https://www.turismo.jujuy.gob.ar/" : "https://www.jujuyturismo.com.ar/salinas-grandes.html"} target="_blank" rel="noreferrer">{action} <span aria-hidden="true">↗</span></a></div></li>)}</ol></section>
  <section id="llegar" class="section transport-section"><div class="transport-copy"><div class="section-tag"><span>05</span>{t.gettingKicker}</div><h2>{t.gettingTitle}</h2><img src={imageUrls.crystallization} alt={lang==="es"?"Pileta de cristalización de sal en Salinas Grandes":"Salt crystallisation pool in Salinas Grandes"}/></div><div class="transport-list">{t.transport.map(([title,body])=><article><h3>{title}</h3><p>{body}</p></article>)}</div></section>
  <section class="documented-photo"><img src={imageUrls.documentedPools} alt={lang==="es"?"Piletas de cristalización en Salinas Grandes":"Crystallisation pools at Salinas Grandes"}/><div><p>{t.photoCredit}</p><a href="https://commons.wikimedia.org/wiki/File:Salinas_grandes_(Salta_y_Jujuy).jpg" target="_blank" rel="noreferrer">{lang==="es"?"Ver atribución y licencia":"View attribution and licence"} <span aria-hidden="true">↗</span></a></div></section>
  <section class="section surroundings-grid"><div><div class="section-tag"><span>06</span>{t.foodKicker}</div><h2>{t.foodTitle}</h2><p class="lead">{t.foodBody}</p></div><div><h3 class="nearby-label">{t.nearbyTitle}</h3><div class="nearby-list">{t.nearby.map(([title,body])=><article><h4>{title}</h4><p>{body}</p></article>)}</div></div></section>
  <section class="map-section"><div><p class="eyebrow">{t.mapKicker}</p><h2>{t.mapTitle}</h2><p>{t.mapText}</p></div><iframe title="Salinas Grandes map" src={mapSrc} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></section>
  <section id="preguntas" class="section faq-section"><div><div class="section-tag"><span>07</span>{t.faqKicker}</div><h2>{t.faqTitle}</h2></div><div class="faq-list">{t.faq.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
  <section class="source-section"><div><p class="eyebrow">{lang==="es"?"Vínculo territorial":"Place association"}</p><h2>{t.sourceTitle}</h2><p>{t.sourceText}</p></div><div class="source-links"><a href="https://www.jujuyturismo.com.ar/salinas-grandes.html" target="_blank" rel="noreferrer">Jujuy Turismo <span>↗</span></a><a href="https://www.turismo.jujuy.gob.ar/" target="_blank" rel="noreferrer">{lang === "es" ? "Ministerio de Cultura y Turismo de Jujuy" : "Jujuy Ministry of Culture and Tourism"} <span>↗</span></a><a href="https://www.argentina.travel/actividades/salinas-grandes-jujuy" target="_blank" rel="noreferrer">{lang === "es" ? "Instituto Nacional de Promoción Turística" : "National Institute for Tourism Promotion"} <span>↗</span></a></div></section>
</main><script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script><script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script></BaseLayout>
