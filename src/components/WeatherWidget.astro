---
// Mapa de Sal style reminder: the weather panel reads like a field instrument—measured, calm, and immediately useful at Puna altitude.
import "../styles/weather.css";
import type { Language } from "../lib/content";

interface Props { lang: Language; }
const { lang } = Astro.props;
const labels = lang === "es"
  ? { kicker: "Tiempo local", title: "El tiempo en Salinas Grandes", intro: "Condiciones actuales y pronóstico del día para orientar una salida a la Puna.", loading: "Consultando condiciones actuales…", loadingSummary: "Preparando el pronóstico local.", temperature: "Temperatura", feels: "Sensación", wind: "Viento", gusts: "Ráfagas", rain: "Prob. de precipitación", visibility: "Visibilidad", range: "Rango de hoy", updated: "Actualización del modelo", source: "Datos meteorológicos: Open-Meteo", note: "El pronóstico ayuda a planificar, pero no autoriza la circulación por la RN 52. Confirmá el estado de la vía con fuentes oficiales antes de salir.", retry: "Volver a intentar", error: "No se pudo actualizar el pronóstico en este momento. Revisá tu conexión o consultá nuevamente antes de viajar.", clear: "Cielo despejado", cloudy: "Nubes variables", fog: "Niebla", drizzle: "Llovizna", rainText: "Lluvia", snow: "Nieve", showers: "Chaparrones", storm: "Tormenta", risk: "Atención: por condiciones previstas, verificá el acceso con autoridades locales el mismo día." }
  : { kicker: "Local weather", title: "Weather at Salinas Grandes", intro: "Current conditions and today’s forecast to help plan a Puna trip.", loading: "Checking current conditions…", loadingSummary: "Preparing the local forecast.", temperature: "Temperature", feels: "Feels like", wind: "Wind", gusts: "Gusts", rain: "Precipitation chance", visibility: "Visibility", range: "Today’s range", updated: "Model update", source: "Weather data: Open-Meteo", note: "This forecast supports trip planning; it is not an authorisation to travel on RN 52. Confirm road conditions through official sources before departing.", retry: "Try again", error: "The forecast could not be updated right now. Check your connection or consult again before travelling.", clear: "Clear sky", cloudy: "Variable cloud", fog: "Fog", drizzle: "Drizzle", rainText: "Rain", snow: "Snow", showers: "Showers", storm: "Thunderstorm", risk: "Caution: based on the forecast, confirm access with local authorities on the same day." };
const apiUrl = "https://api.open-meteo.com/v1/forecast?latitude=-23.608535&longitude=-65.867148&current=temperature_2m,apparent_temperature,relative_humidity_2m,precipitation,weather_code,wind_speed_10m,wind_gusts_10m,visibility&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=America%2FArgentina%2FJujuy&forecast_days=1&wind_speed_unit=kmh";
---
<section class="weather-section" aria-labelledby="weather-title" data-weather-widget>
  <div class="weather-heading">
    <div><p class="eyebrow">{labels.kicker}</p><h2 id="weather-title">{labels.title}</h2><p>{labels.intro}</p></div>
    <div class="weather-reference"><span>23.608535° S · 65.867148° O</span><b>3.350 m</b></div>
  </div>
  <div class="weather-board" aria-live="polite" aria-busy="true">
    <div class="weather-primary">
      <p class="weather-status" data-weather-status>{labels.loading}</p>
      <p class="weather-temperature"><span data-weather-temp>—</span><sup>°C</sup></p>
      <p class="weather-summary" data-weather-summary>{labels.loadingSummary}</p>
      <p class="weather-updated" data-weather-updated></p>
    </div>
    <dl class="weather-metrics">
      <div><dt>{labels.feels}</dt><dd data-weather-feels>—</dd></div>
      <div><dt>{labels.wind}</dt><dd data-weather-wind>—</dd></div>
      <div><dt>{labels.gusts}</dt><dd data-weather-gusts>—</dd></div>
      <div><dt>{labels.rain}</dt><dd data-weather-rain>—</dd></div>
      <div><dt>{labels.visibility}</dt><dd data-weather-visibility>—</dd></div>
      <div><dt>{labels.range}</dt><dd data-weather-range>—</dd></div>
    </dl>
  </div>
  <div class="weather-footer"><p data-weather-note>{labels.note}</p><div><a href="https://open-meteo.com/" target="_blank" rel="noreferrer">{labels.source} <span aria-hidden="true">↗</span></a><button class="weather-retry" type="button" data-weather-retry hidden>{labels.retry}</button></div></div>
  <p class="weather-error" data-weather-error hidden></p>
  <noscript><p class="weather-noscript">{labels.note}</p></noscript>
</section>
<script is:inline define:vars={{ apiUrl, labels }}>
  const root = document.querySelector("[data-weather-widget]");
  if (root) {
    const setText = (selector, value) => { const element = root.querySelector(selector); if (element) element.textContent = value; };
    const condition = (code) => {
      if (code === 0) return labels.clear;
      if ([1, 2, 3].includes(code)) return labels.cloudy;
      if ([45, 48].includes(code)) return labels.fog;
      if ([51, 53, 55, 56, 57].includes(code)) return labels.drizzle;
      if ([61, 63, 65, 66, 67].includes(code)) return labels.rainText;
      if ([71, 73, 75, 77, 85, 86].includes(code)) return labels.snow;
      if ([80, 81, 82].includes(code)) return labels.showers;
      if ([95, 96, 99].includes(code)) return labels.storm;
      return labels.cloudy;
    };
    const showError = () => {
      root.setAttribute("aria-busy", "false");
      const retry = root.querySelector("[data-weather-retry]"); const error = root.querySelector("[data-weather-error]");
      if (retry) retry.hidden = false; if (error) { error.hidden = false; error.textContent = labels.error; }
      setText("[data-weather-status]", labels.error); setText("[data-weather-summary]", labels.note);
    };
    const loadWeather = async () => {
      root.setAttribute("aria-busy", "true");
      const retry = root.querySelector("[data-weather-retry]"); const error = root.querySelector("[data-weather-error]");
      if (retry) retry.hidden = true; if (error) error.hidden = true;
      try {
        const response = await fetch(apiUrl, { headers: { Accept: "application/json" } });
        if (!response.ok) throw new Error("Forecast request failed");
        const data = await response.json(); const current = data.current; const daily = data.daily;
        if (!current || !daily || !Number.isFinite(current.temperature_2m)) throw new Error("Forecast response unavailable");
        const chance = daily.precipitation_probability_max?.[0] ?? 0;
        const gusts = current.wind_gusts_10m ?? 0;
        setText("[data-weather-status]", condition(current.weather_code));
        setText("[data-weather-temp]", Math.round(current.temperature_2m));
        setText("[data-weather-summary]", `${labels.temperature}: ${Math.round(current.temperature_2m)} °C · ${labels.rain}: ${chance}%`);
        setText("[data-weather-feels]", `${Math.round(current.apparent_temperature)} °C`);
        setText("[data-weather-wind]", `${Math.round(current.wind_speed_10m)} km/h`);
        setText("[data-weather-gusts]", `${Math.round(gusts)} km/h`);
        setText("[data-weather-rain]", `${chance}%`);
        setText("[data-weather-visibility]", current.visibility == null ? "—" : `${(current.visibility / 1000).toFixed(1)} km`);
        setText("[data-weather-range]", `${Math.round(daily.temperature_2m_min?.[0])}–${Math.round(daily.temperature_2m_max?.[0])} °C`);
        setText("[data-weather-updated]", `${labels.updated}: ${String(current.time).replace("T", " · ")}`);
        setText("[data-weather-note]", gusts >= 50 || chance >= 60 || [45, 48, 95, 96, 99].includes(current.weather_code) ? labels.risk : labels.note);
        root.setAttribute("aria-busy", "false");
      } catch (error) { showError(); }
    };
    root.querySelector("[data-weather-retry]")?.addEventListener("click", loadWeather);
    loadWeather();
  }
</script>
