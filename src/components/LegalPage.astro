---
// Mapa de Sal style reminder: legal reading remains calm, spacious and cartographically structured, without modal interruptions.
import BaseLayout from "../layouts/BaseLayout.astro";
import { legalCopy, type Language, type LegalDocument } from "../lib/content";
interface Props { lang: Language; document: LegalDocument }
const { lang, document } = Astro.props; const doc = legalCopy[lang][document];
const home = lang === "en" ? "/en/" : "/"; const canonicalPath = lang === "en" ? `/en/${document}` : `/${document}`;
---
<BaseLayout lang={lang} title={`${doc.title} | Salinas Grandes Guide`} description={doc.intro} canonicalPath={canonicalPath}><main class="legal-page"><div class="legal-hero"><a href={home}>← {lang === "es" ? "Volver a la guía" : "Back to guide"}</a><p class="eyebrow">Salinas Grandes · RN 52</p><h1>{doc.title}</h1><p>{doc.intro}</p></div><article class="legal-article">{doc.sections.map(([title,body],index)=><section><span>0{index+1}</span><div><h2>{title}</h2><p>{body}</p></div></section>)}</article>{document === "cookies" && <section class="cookie-controls"><h2>{lang === "es" ? "Elegí tus preferencias" : "Choose your preferences"}</h2><p>{lang === "es" ? "La elección se guarda en este navegador. Las cookies necesarias permanecen activas." : "Your choice is stored in this browser. Necessary cookies remain active."}</p><div><button class="button button-primary" type="button" data-cookie-action="analytics">{lang === "es" ? "Guardar preferencias" : "Save preferences"}</button><button class="button button-quiet" type="button" data-cookie-action="reject">{lang === "es" ? "Rechazar todo" : "Reject all"}</button></div><p class="cookie-status" data-cookie-status aria-live="polite"></p></section>}</main></BaseLayout>
