---
// Mapa de Sal style reminder: direct Spanish legal routes with a quiet document layout, never a modal.
import LegalPage from "../components/LegalPage.astro";
import type { LegalDocument } from "../lib/content";
export const prerender = true;
export function getStaticPaths() { return ["privacy", "terms", "cookies"].map((legal) => ({ params: { legal } })); }
const legal = Astro.params.legal as LegalDocument;
---
<LegalPage lang="es" document={legal} />
